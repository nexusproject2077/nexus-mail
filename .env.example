# Docker Compose configuration for self-hosting Nexus Mail.

# Secret that encrypts stored IMAP/SMTP credentials at rest (AES-256-GCM).
# Generate one with: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-secret

# URL the browser uses to reach the backend API.
# For remote hosting, set this to your public backend URL (https://mail.example.com).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Origin allowed by the backend CORS policy (should match where the frontend runs).
FRONTEND_ORIGIN=http://localhost:3000

# Optional Google OAuth server-only values used by Docker Compose.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/

# Backend login is server-only; see backend/.env.example. Never prefix it with NEXT_PUBLIC_.
