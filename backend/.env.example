# Nexus Mail backend configuration

# Port the API listens on.
PORT=4000
HOST=127.0.0.1
NODE_ENV=production

# Secret used to derive the AES key that encrypts stored IMAP/SMTP credentials.
# Generate a strong value, e.g.: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-secret

# SQLite database file (created automatically).
DB_PATH=./data/nexus.db

# Allowed CORS origin for the frontend (use the exact origin in production).
CORS_ORIGIN=http://localhost:3000

# Login for this single-owner self-hosted instance. Set AUTH_PASSWORD_HASH with:
# node -e "const c=require('crypto');const s=c.randomBytes(16);c.scrypt(process.argv[1],s,64,{N:16384,r:8,p:1},(e,k)=>console.log('scrypt$16384$8$1$'+s.toString('base64')+'$'+k.toString('base64')))" "your-password"
AUTH_USERNAME=owner
AUTH_PASSWORD_HASH=scrypt$16384$8$1$replace-with-generated-hash
AUTH_USER_ID=owner
SESSION_TTL_HOURS=168
# Behind Apache at /mail/ use the default. For root deployment use /.
COOKIE_PATH=/mail
COOKIE_SECURE=true

# Google OAuth 2.0 web client (server-only; do not commit real values).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.mmi25b11.mmi-troyes.fr/mail/api/oauth/google/callback
OAUTH_SUCCESS_REDIRECT=https://nexusproject2077.github.io/nexus-mail/
